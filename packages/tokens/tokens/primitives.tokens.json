{
  "$schema": "https://www.designtokens.org/schemas/2025.10/tokens.json",
  "$description": "GDS tier 1: raw values. The only file a brand replaces. v0.1 placeholders: Radix Colors scales (MIT) for ramps, Okabe-Ito for data categorical. Nothing here carries brand meaning.",
  "color": {
    "$type": "color",
    "neutral": {
      "light": {
        "1": { "$value": "#fcfcfc", "$description": "App background" },
        "2": { "$value": "#f9f9f9", "$description": "Subtle background" },
        "3": { "$value": "#f0f0f0", "$description": "Component background, rest" },
        "4": { "$value": "#e8e8e8", "$description": "Component background, hover" },
        "5": { "$value": "#e0e0e0", "$description": "Component background, active" },
        "6": { "$value": "#d9d9d9", "$description": "Border, subtle" },
        "7": { "$value": "#cecece", "$description": "Border, default" },
        "8": { "$value": "#bbbbbb", "$description": "Border, strong" },
        "9": { "$value": "#8d8d8d", "$description": "Solid fill, rest" },
        "10": { "$value": "#838383", "$description": "Solid fill, hover" },
        "11": { "$value": "#646464", "$description": "Text, low contrast" },
        "12": { "$value": "#202020", "$description": "Text, high contrast" }
      },
      "dark": {
        "1": { "$value": "#111111" },
        "2": { "$value": "#191919" },
        "3": { "$value": "#222222" },
        "4": { "$value": "#2a2a2a" },
        "5": { "$value": "#313131" },
        "6": { "$value": "#3a3a3a" },
        "7": { "$value": "#484848" },
        "8": { "$value": "#606060" },
        "9": { "$value": "#6e6e6e" },
        "10": { "$value": "#7b7b7b" },
        "11": { "$value": "#b4b4b4" },
        "12": { "$value": "#eeeeee" }
      }
    },
    "blue": {
      "$description": "Functional hue: info status, focus ring, links. Placeholder until the brand defines its accent.",
      "light": {
        "1": { "$value": "#fbfdff" },
        "2": { "$value": "#f4faff" },
        "3": { "$value": "#e6f4fe" },
        "4": { "$value": "#d5efff" },
        "5": { "$value": "#c2e5ff" },
        "6": { "$value": "#acd8fc" },
        "7": { "$value": "#8ec8f6" },
        "8": { "$value": "#5eb1ef" },
        "9": { "$value": "#0090ff" },
        "10": { "$value": "#0588f0" },
        "11": { "$value": "#0d74ce" },
        "12": { "$value": "#113264" }
      },
      "dark": {
        "1": { "$value": "#0d1520" },
        "2": { "$value": "#111927" },
        "3": { "$value": "#0d2847" },
        "4": { "$value": "#003362" },
        "5": { "$value": "#004074" },
        "6": { "$value": "#104d87" },
        "7": { "$value": "#205d9e" },
        "8": { "$value": "#2870bd" },
        "9": { "$value": "#0090ff" },
        "10": { "$value": "#3b9eff" },
        "11": { "$value": "#70b8ff" },
        "12": { "$value": "#c2e6ff" }
      }
    },
    "green": {
      "$description": "Functional hue: good status.",
      "light": {
        "1": { "$value": "#fbfefc" },
        "2": { "$value": "#f4fbf6" },
        "3": { "$value": "#e6f6eb" },
        "4": { "$value": "#d6f1df" },
        "5": { "$value": "#c4e8d1" },
        "6": { "$value": "#adddc0" },
        "7": { "$value": "#8eceaa" },
        "8": { "$value": "#5bb98b" },
        "9": { "$value": "#30a46c" },
        "10": { "$value": "#2b9a66" },
        "11": { "$value": "#1e7a51" },
        "12": { "$value": "#193b2d" }
      },
      "dark": {
        "1": { "$value": "#0e1512" },
        "2": { "$value": "#121b17" },
        "3": { "$value": "#132d21" },
        "4": { "$value": "#113b29" },
        "5": { "$value": "#174933" },
        "6": { "$value": "#20573e" },
        "7": { "$value": "#28684a" },
        "8": { "$value": "#2f7c57" },
        "9": { "$value": "#30a46c" },
        "10": { "$value": "#33b074" },
        "11": { "$value": "#3dd68c" },
        "12": { "$value": "#b1f1cb" }
      }
    },
    "amber": {
      "$description": "Functional hue: warning status.",
      "light": {
        "1": { "$value": "#fefdfb" },
        "2": { "$value": "#fefbe9" },
        "3": { "$value": "#fff7c2" },
        "4": { "$value": "#ffee9c" },
        "5": { "$value": "#fbe577" },
        "6": { "$value": "#f3d673" },
        "7": { "$value": "#e9c162" },
        "8": { "$value": "#e2a336" },
        "9": {
          "$value": "#d97706",
          "$description": "Darker than Radix amber 9 so a solid warning fill meets 3:1 on light surfaces"
        },
        "10": { "$value": "#b45309" },
        "11": { "$value": "#9a5a00" },
        "12": { "$value": "#4f3422" }
      },
      "dark": {
        "1": { "$value": "#16120c" },
        "2": { "$value": "#1d180f" },
        "3": { "$value": "#302008" },
        "4": { "$value": "#3f2700" },
        "5": { "$value": "#4d3000" },
        "6": { "$value": "#5c3d05" },
        "7": { "$value": "#714f19" },
        "8": { "$value": "#8f6424" },
        "9": { "$value": "#ffc53d" },
        "10": { "$value": "#ffd60a" },
        "11": { "$value": "#ffca16" },
        "12": { "$value": "#ffe7b3" }
      }
    },
    "red": {
      "$description": "Functional hue: critical status, destructive actions.",
      "light": {
        "1": { "$value": "#fffcfc" },
        "2": { "$value": "#fff7f7" },
        "3": { "$value": "#feebec" },
        "4": { "$value": "#ffdbdc" },
        "5": { "$value": "#ffcdce" },
        "6": { "$value": "#fdbdbe" },
        "7": { "$value": "#f4a9aa" },
        "8": { "$value": "#eb8e90" },
        "9": { "$value": "#e5484d" },
        "10": { "$value": "#dc3e42" },
        "11": { "$value": "#ce2c31" },
        "12": { "$value": "#641723" }
      },
      "dark": {
        "1": { "$value": "#191111" },
        "2": { "$value": "#201314" },
        "3": { "$value": "#3b1219" },
        "4": { "$value": "#500f1c" },
        "5": { "$value": "#611623" },
        "6": { "$value": "#72232d" },
        "7": { "$value": "#8c333a" },
        "8": { "$value": "#b54548" },
        "9": { "$value": "#e5484d" },
        "10": { "$value": "#ec5d5e" },
        "11": { "$value": "#ff9592" },
        "12": { "$value": "#ffd1d9" }
      }
    },
    "categorical": {
      "$description": "Chart colors, not a ramp. Categorical set is Okabe-Ito, color-vision safe; the same eight serve both modes in v0.1.",
      "1": { "$value": "#0072b2" },
      "2": { "$value": "#e69f00" },
      "3": { "$value": "#009e73" },
      "4": { "$value": "#cc79a7" },
      "5": { "$value": "#56b4e9" },
      "6": { "$value": "#d55e00" },
      "7": { "$value": "#f0e442" },
      "8": { "$value": "#999999" }
    },
    "sequential": {
      "1": { "$value": "#e6f4fe" },
      "2": { "$value": "#acd8fc" },
      "3": { "$value": "#5eb1ef" },
      "4": { "$value": "#0d74ce" },
      "5": { "$value": "#113264" }
    },
    "diverging": {
      "negative": { "$value": "#ce2c31" },
      "neutral": { "$value": "#e8e8e8" },
      "positive": { "$value": "#0d74ce" }
    },
    "alpha": {
      "$description": "Overlays and scrims.",
      "black": {
        "40": { "$value": "#00000066" },
        "60": { "$value": "#00000099" }
      },
      "white": {
        "40": { "$value": "#ffffff66" }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": ["ui-sans-serif", "system-ui", "sans-serif"],
        "$description": "Placeholder. Brand display face in December."
      },
      "text": {
        "$value": ["ui-sans-serif", "system-ui", "sans-serif"],
        "$description": "Placeholder. Brand text face in December."
      },
      "mono": { "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "$description": "16px base, ratio 1.2. Step 200 is body.",
      "50": { "$value": { "value": 0.75, "unit": "rem" } },
      "100": { "$value": { "value": 0.875, "unit": "rem" } },
      "200": { "$value": { "value": 1, "unit": "rem" } },
      "300": { "$value": { "value": 1.2, "unit": "rem" } },
      "400": { "$value": { "value": 1.44, "unit": "rem" } },
      "500": { "$value": { "value": 1.728, "unit": "rem" } },
      "600": { "$value": { "value": 2.074, "unit": "rem" } },
      "700": { "$value": { "value": 2.488, "unit": "rem" } },
      "800": { "$value": { "value": 2.986, "unit": "rem" } }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.1 },
      "snug": { "$value": 1.25 },
      "normal": { "$value": 1.5 },
      "relaxed": { "$value": 1.6 }
    },
    "letter-spacing": {
      "$type": "dimension",
      "tight": { "$value": { "value": -0.01, "unit": "rem" } },
      "normal": { "$value": { "value": 0, "unit": "rem" } },
      "wide": { "$value": { "value": 0.04, "unit": "rem" } }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base. Step n = n × 0.25rem.",
    "0": { "$value": { "value": 0, "unit": "rem" } },
    "1": { "$value": { "value": 0.25, "unit": "rem" } },
    "2": { "$value": { "value": 0.5, "unit": "rem" } },
    "3": { "$value": { "value": 0.75, "unit": "rem" } },
    "4": { "$value": { "value": 1, "unit": "rem" } },
    "5": { "$value": { "value": 1.25, "unit": "rem" } },
    "6": { "$value": { "value": 1.5, "unit": "rem" } },
    "8": { "$value": { "value": 2, "unit": "rem" } },
    "10": { "$value": { "value": 2.5, "unit": "rem" } },
    "12": { "$value": { "value": 3, "unit": "rem" } },
    "16": { "$value": { "value": 4, "unit": "rem" } },
    "20": { "$value": { "value": 5, "unit": "rem" } },
    "24": { "$value": { "value": 6, "unit": "rem" } }
  },
  "size": {
    "$type": "dimension",
    "$description": "Fixed sizes. px steps do not scale with user font size; rem steps do. Roles (control, icon, layout) live in semantic/base.",
    "px": {
      "16": { "$value": { "value": 16, "unit": "px" } },
      "20": { "$value": { "value": 20, "unit": "px" } },
      "24": { "$value": { "value": 24, "unit": "px" } },
      "32": { "$value": { "value": 32, "unit": "px" } },
      "40": { "$value": { "value": 40, "unit": "px" } },
      "44": { "$value": { "value": 44, "unit": "px" } },
      "48": { "$value": { "value": 48, "unit": "px" } },
      "56": { "$value": { "value": 56, "unit": "px" } },
      "264": { "$value": { "value": 264, "unit": "px" } },
      "1440": { "$value": { "value": 1440, "unit": "px" } }
    },
    "rem": {
      "42": { "$value": { "value": 42, "unit": "rem" } }
    }
  },
  "radius": {
    "$type": "dimension",
    "0": { "$value": { "value": 0, "unit": "px" } },
    "1": { "$value": { "value": 2, "unit": "px" } },
    "2": { "$value": { "value": 4, "unit": "px" } },
    "3": { "$value": { "value": 8, "unit": "px" } },
    "4": { "$value": { "value": 12, "unit": "px" } },
    "full": { "$value": { "value": 9999, "unit": "px" } }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "1": { "$value": { "value": 1, "unit": "px" } },
      "2": { "$value": { "value": 2, "unit": "px" } }
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Elevation. Dark mode uses the same shadows at lower opacity via the alpha primitives.",
    "1": {
      "$value": {
        "color": "#00000014",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 1, "unit": "px" },
        "blur": { "value": 2, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "2": {
      "$value": {
        "color": "#0000001f",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 4, "unit": "px" },
        "blur": { "value": 12, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "3": {
      "$value": {
        "color": "#00000029",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 12, "unit": "px" },
        "blur": { "value": 32, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": { "value": 100, "unit": "ms" } },
      "base": { "$value": { "value": 200, "unit": "ms" } },
      "slow": { "$value": { "value": 320, "unit": "ms" } }
    },
    "curve": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "enter": { "$value": [0, 0, 0.2, 1] },
      "exit": { "$value": [0.4, 0, 1, 1] }
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.5 },
    "muted": { "$value": 0.7 }
  },
  "z": {
    "$type": "number",
    "$description": "Stacking order. Components use these, never literals.",
    "base": { "$value": 0 },
    "raised": { "$value": 10 },
    "sticky": { "$value": 100 },
    "overlay": { "$value": 1000 },
    "popover": { "$value": 1100 },
    "toast": { "$value": 1200 }
  }
}
